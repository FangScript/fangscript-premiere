{
  "openapi": "3.1.0",
  "info": {
    "title": "FangScript CRM",
    "version": "1.0.0"
  },
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/v1/crm/records": {
      "get": {
        "summary": "Paginated authorized records",
        "parameters": [
          {
            "in": "query",
            "name": "kind",
            "schema": {
              "type": "string",
              "enum": [
                "contacts",
                "companies",
                "deals",
                "activities"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Record page"
          },
          "401": {
            "description": "Sign in required"
          },
          "403": {
            "description": "Role or tenant not authorized"
          }
        }
      },
      "post": {
        "summary": "Create an authorized record",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Persisted record"
          },
          "400": {
            "description": "Invalid input"
          }
        }
      }
    },
    "/api/v1/crm/records/{id}": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Optimistic update; version required",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecordInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated record"
          },
          "409": {
            "description": "Version conflict"
          }
        }
      },
      "get": {
        "summary": "CRM /records/:id",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful persisted operation"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Workflow or version conflict"
          },
          "503": {
            "description": "Provider or dependency unavailable"
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Process alive"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "security": [],
        "responses": {
          "200": {
            "description": "Dependencies ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    },
    "/api/v1/crm/capabilities": {
      "get": {
        "summary": "CRM /capabilities",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful persisted operation"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Workflow or version conflict"
          },
          "503": {
            "description": "Provider or dependency unavailable"
          }
        }
      }
    },
    "/api/v1/crm/records/{id}/revisions": {
      "get": {
        "summary": "CRM /records/:id/revisions",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful persisted operation"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Workflow or version conflict"
          },
          "503": {
            "description": "Provider or dependency unavailable"
          }
        }
      }
    },
    "/api/v1/crm/records/{id}/restore": {
      "post": {
        "summary": "CRM /records/:id/restore",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful persisted operation"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Workflow or version conflict"
          },
          "503": {
            "description": "Provider or dependency unavailable"
          }
        }
      }
    },
    "/api/v1/crm/records/{id}/action": {
      "post": {
        "summary": "CRM /records/:id/action",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful persisted operation"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Permission denied"
          },
          "409": {
            "description": "Workflow or version conflict"
          },
          "503": {
            "description": "Provider or dependency unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action",
                  "version"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "enum": [
                      "publish",
                      "unpublish",
                      "send",
                      "accept",
                      "reject",
                      "approve",
                      "mark-paid",
                      "mark-posted",
                      "complete"
                    ]
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "fs_access"
      }
    },
    "schemas": {
      "RecordInput": {
        "type": "object",
        "required": [
          "kind",
          "title",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "contacts",
              "companies",
              "deals",
              "activities"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "tenantId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "data": {
            "type": "object"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
