{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FangScript event v1",
  "type": "object",
  "required": [
    "id",
    "type",
    "occurred_at",
    "source",
    "actor",
    "tenant_id",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z.-]+\\.v1$"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string"
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "user",
            "system",
            "agent"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    },
    "data": {
      "type": "object"
    }
  }
}